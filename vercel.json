{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/studio/image/export",
      "destination": "/studio/image/export/index.html"
    },
    {
      "source": "/studio/image/export/",
      "destination": "/studio/image/export/index.html"
    }
  ]
}
